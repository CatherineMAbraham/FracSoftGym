<robot name="proximal.obj">
	<link name="proximal">
		<visual>
			<origin rpy="0.0 0.0 0.0" xyz="0 0 0" />
			<geometry>
				<mesh filename="proximal_102.obj" scale="1 1 1" />
			</geometry>
			<material name="texture">
				<color rgba="0.0 0.0 0.0 1.0" />
			</material>
		</visual>
		<collision>
			<origin rpy="0.0 0.0 0.0" xyz="0 0 0" />
			<geometry>
				<mesh filename="proximal1022_vhacd.obj" scale="0.95 0.95 0.95" />
			</geometry>
		</collision>
		<inertial>
			<mass value="1.0" />
			<inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
		</inertial>
	</link>

  <joint name="leg" type="fixed">
    <parent link="proximal"/>
    <child link="patient"/>
    <origin xyz="0.0009518 -0.1498613 0.4550867" rpy="0 0 0"/>
  </joint>
	
	<link name="patient">
		<visual>
			<origin rpy="0.0 0.0 0.0" xyz="0 0 0" />
			<geometry>
				<mesh filename="patient.obj" scale="0.5 0.5 0.5" />
			</geometry>
			<material name="texture">
				<color rgba="1.0 1.0 1.0 1.0" />
			</material>
		</visual>
		<collision>
			<origin rpy="0.0 0.0 0.0" xyz="0 0 0" />
			<geometry>
				<mesh filename="patient_vhacd.obj" scale="0.5 0.5 0.5" />
			</geometry>
		</collision>
		<inertial>
			<mass value="1.0" />
			<inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
		</inertial>
	</link>
</robot>