<?xml version="1.0" ?>
<robot name="L_shaped_tool">

  <!-- Root link -->
  <link name="moving_link">
    <inertial>
      <mass value="0.276" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.0004" iyz="0.0" izz="0.0004" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry><mesh filename="distal_2522.obj" scale="1 1 1" /></geometry>
      <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry><mesh filename="distal_252_vhacd.obj" scale="1 1 1" /></geometry>
    </collision>
  </link>

  <joint name="ankle_mount_joint" type="fixed">
    <parent link="moving_link"/>
    <child link="pin_link"/>
    <origin xyz="0 0.08 0.03" rpy="-1.57 0 0"/>
  </joint>

  <link name="pin_link">
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <mass value="0.01"/> <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry><box size="0.008 0.01 0.08"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry><box size="0.008 0.01 0.08"/></geometry>
    </collision>
  </link>

  <joint name="load_cell_joint" type="fixed">
    <parent link="pin_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.04 0 0" rpy="0 0 1.57"/>
      <mass value="0.01"/> <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="-0.04 -0.0 0" rpy="0 0 1.57"/>
      <geometry><box size="0.01 0.08 0.01"/></geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.04 0 0" rpy="0 0 1.57"/>
      <geometry><box size="0.01 0.08 0.01"/></geometry>
    </collision>
  </link>

</robot>